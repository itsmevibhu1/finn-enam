# Copy to .env.local. Never commit .env.local or paste the key into chat.
# Create the key in a Google AI Studio free-tier project; do not enable billing.
FINN_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Application cap, separate from Google's project quotas; resets at midnight UTC.
FINN_GEMINI_DAILY_REQUEST_LIMIT=8
